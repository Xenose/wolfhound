
FUNCTION(WH_FIND_LIB LIB_NAME)
	FIND_PACKAGE(${LIB_NAME} QUIET)
	SET(LIB_FOUND FALSE)

	STRING(TOUPPER ${LIB_NAME} UPPER_LIB_NAME)

	IF (${${UPPER_LIB_NAME}_DISABLED})
		MESSAGE("${LOG_PREFIX} ${LIB_NAME} library disabled by user. ${LIB_NAME} features will be disabled.")
		LIST(APPEND WH_DEFS WH_${UPPER_LIB_NAME}_NOT_FOUND)
	ELSEIF(${LIB_NAME}_FOUND)
		MESSAGE("${LOG_PREFIX} Found ${LIB_NAME} (Version ${${UPPER_LIB_NAME}_VERSION})")
		LIST(APPEND C_SOURCES ${${UPPER_LIB_NAME}_SOURCES})

		IF(TARGET ${LIB_NAME}::${LIB_NAME})
			LIST(APPEND WH_LIBS ${LIB_NAME}::${LIB_NAME})
		ELSE()
			LIST(APPEND WH_LIBS ${${UPPER_LIB_NAME}_LIBRARIES})
			LIST(APPEND WH_INCLUDES ${${UPPER_LIB_NAME}_INCLUDE_DIRS})
		ENDIF()
		
		SET(LIB_FOUND TRUE)
	ELSE()
		MESSAGE("${LOG_PREFIX} Did not find pakage [ ${LIB_NAME} ] doing it old school.")

		FIND_PATH(INC_DIR
				NAMES ${LIB_HEADER_NAMES}
				PATH_SUFFIXES ${INCLUDE_PREFIX} include/Headers include/lib${UPPER_LIB_NAME} include/lib${LIB_NAME} include
		)

		IF(NOT INC_DIR)
			MESSAGE("${LOG_PREFIX} ${LIB_NAME} library not found. ${LIB_NAME} features will be disabled.")
			LIST(APPEND WH_DEFS WH_${UPPER_LIB_NAME}_NOT_FOUND)
		ELSE()
			MESSAGE("${LOG_PREFIX} ${LIB_NAME} headers found!")

			FIND_LIBRARY(LIB_${LIB_NAME}
				NAMES ${LIB_NAME_ALTS}
				PATH_SUFFIXES Lib lib
			)

			IF(NOT LIB_${LIB_NAME})
				# TODO download

				FIND_LIBRARY(LIB_${LIB_NAME}
					NAMES ${LIB_NAME_ALTS}
				)
			ENDIF()

			IF(LIB_${LIB_NAME})
				MESSAGE("${LOG_PREFIX} ${LIB_NAME} appending to the included libs...")
				LIST(APPEND C_SOURCES ${${UPPER_LIB_NAME}_SOURCES})
				LIST(APPEND WH_LIBS ${LIB_${LIB_NAME}})
				LIST(APPEND WH_INCLUDES ${INC_DIR})

				SET(LIB_FOUND TRUE)
			ELSE()
				MESSAGE(WARNING "${LOG_PREFIX} ${LIB_NAME} library not found. ${LIB_NAME} features will be disabled.")

				SET("WH_${UPPER_LIB_NAME}_NOT_FOUND" TRUE PARENT_SCOPE)
				LIST(APPEND WH_DEFS "WH_${UPPER_LIB_NAME}_NOT_FOUND")
			ENDIF()
		ENDIF ()
	ENDIF()

	IF(LIB_FOUND)
		MESSAGE("${LOG_PREFIX} Found library ${LIB_NAME} --- [ ${WH_LIBS} --- ${WH_INCLUDE} ]")
		SET(C_SOURCES		${C_SOURCES}	PARENT_SCOPE)
		SET(WH_LIBS			${WH_LIBS}		PARENT_SCOPE)
		SET(WH_INCLUDES	${WH_INCLUDES}	PARENT_SCOPE)
		SET(WH_DEFS			${WH_DEFS}		PARENT_SCOPE)
	ELSE()
		SET(WH_DEFS			${WH_DEFS}		PARENT_SCOPE)
	ENDIF()
ENDFUNCTION()

FUNCTION(WH_FIND_V2 IN_NAME IN_LIB_NAMES IN_INCLUDE_NAMES IN_PATH_SUFFIX IS_DISABLED OUT_LIB OUT_INCLUDE)
	SET(LIB_FOUND FALSE)
	SET(HEADER_FUND FALSE)

	STRING(TOUPPER ${IN_NAME} NAME_UPPER)
	MESSAGE("\n\n${LOG_PREFIX} SERCHING FOR ${NAME_UPPER}")

	IF(IS_DISABLED)
		MESSAGE("${LOG_PREFIX} Library [ ${NAME_UPPER} ] disbled by user")
		RETURN()
	ENDIF()

	FIND_PACKAGE(${IN_NAME} NAMES ${IN_LIB_NAMES} QUIET)

	IF(${IN_NAME}_FOUND)
		IF(TARGET ${IN_NAME}::${IN_NAME})
			SET(${OUT_LIB} "${IN_NAME}::${IN_NAME}" PARENT_SCOPE)
		ELSE()
			SET(${OUT_LIB} "${${IN_NAME}_LIBRARIES}" PARENT_SCOPE)
			SET(${OUT_INCLUDE} "${${IN_NAME}_INCLUDE_DIRS}" PARENT_SCOPE)
		ENDIF()

		SET(LIB_FOUND TRUE)
	ENDIF()

	IF(NOT LIB_FOUND)
		MESSAGE("${LOG_PREFIX} Did not find pakage [ ${NAME_UPPER} ] doing it old school way...")
		
		FIND_LIBRARY(VAR_LIBRARY
			NAMES ${IN_LIB_NAMES}
			PATH_SUFFIXES ${IN_PATH_SUFFIX} Lib lib
		)

		FIND_PATH(VAR_INCLUDE
				NAMES ${IN_INCLUDE_NAMES}
				PATH_SUFFIXES ${IN_PATH_SUFFIX} include
		)

		IF(VAR_LIBRARY AND VAR_INCLUDE)
			SET(${OUT_LIB} ${VAR_LIBRARY} PARENT_SCOPE)
			SET(${OUT_INCLUDE} ${VAR_INCLUDE} PARENT_SCOPE)
			SET(LIB_FOUND TRUE)
		ELSE()
			MESSAGE("${LOG_PREFIX} Failed to find [ ${NAME_UPPER} ]")
		ENDIF()
	ENDIF()

	IF (LIB_FOUND)
		MESSAGE("${LOG_PREFIX} Found [ ${NAME_UPPER} ]")
	ENDIF()
ENDFUNCTION()
