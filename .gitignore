# Ignore all build directories recursively
build/
docs/
**/build/
**/build-*/
**/CMakeFiles/

# Python temp files
__pycache__/
*.pyc
.pyre/

# Wolfhound files
.target
.servers
.wolfhound/

# CMake generated files
CMakeCache.txt
cmake_install.cmake
Makefile
compile_commands.json
CTestTestfile.cmake
CPackConfig.cmake
CPackSourceConfig.cmake

# Ninja
*.ninja
rules.ninja

# Compiled object files and libraries
*.o
*.obj
*.lib
*.a
*.lo
*.la
*.so
*.so.*
*.dll
*.exe
*.out
*.pdb
*.idb
*.bin
*.msi

# other 
**.obsidian/
vgcore.*
perf.data
perf.data.old

# Ignore by-product directories
**/CMakeFiles/
**/CMakeScratch/
**/CompilerId*/
**/reports/

# Visual Studio files
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.user
*.suo
*.ncb
*.opensdf
*.sdf
*.ipch
*.cache
*.log

# Qt/Visual Studio Code IDE
.vscode/
.idea/
*.pro.user
*.qmake.stash

# Backup & temporary files
*~
*.swp
*.bak
*.tmp
*.temp
*.log
*.orig

# Generated binaries or external DLLs
**/*.dll

# System
.DS_Store
*.swp
*.tmp
